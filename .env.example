# TibbeShifa Migrator — copy this to .env and fill in your values.
# NEVER commit .env to git.

# === SOURCE STORE (tibbeshifa.com / *.myshopify.com) ===
# Enter into .env only — never paste tokens in chat.
SOURCE_SHOP=yourstore.myshopify.com
SOURCE_CLIENT_ID=
SOURCE_CLIENT_SECRET=
# OR if using a pre-minted offline token:
# SOURCE_ADMIN_TOKEN=shpat_...

# === DESTINATION STORE (new store *.myshopify.com) ===
DEST_SHOP=newstore.myshopify.com
DEST_CLIENT_ID=
DEST_CLIENT_SECRET=
# DEST_ADMIN_TOKEN=shpat_...

# === GLOBAL SETTINGS ===
# Pinned API version — do not change without reading release notes.
SHOPIFY_API_VERSION=2026-10

# Dry-run mode: set to "true" to block all writes (default safe state).
# To perform real writes you must pass --apply at the CLI AND set this to "false".
DRY_RUN=true

# Log level: debug | info | warn | error
LOG_LEVEL=info
