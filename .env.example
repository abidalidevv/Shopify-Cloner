# Clonix SaaS & Migration Engine — Environment Configuration
# Copy this file to .env and populate with production / staging secrets.
# NEVER commit real .env files to git.

# ==============================================================================
# 1. APPLICATION & SERVER SETTINGS
# ==============================================================================
PORT=3000
NODE_ENV=development
APP_URL=https://app.clonix.com
LOG_LEVEL=info

# ==============================================================================
# 2. DATABASE & QUEUE (PostgreSQL + pg-boss)
# ==============================================================================
# Direct connection for workers and PgBoss doorbell queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clonix?sslmode=disable
# Optional PgBouncer connection pooler for HTTP request threads
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/clonix?sslmode=disable

# ==============================================================================
# 3. SECURITY & CRYPTO PEPPERS (Required for offline brute-force protection)
# ==============================================================================
# 32-byte hex key for AES-256-GCM token envelope encryption
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Server-side pepper for Crockford pairing tokens (HMAC-SHA256)
PAIR_PEPPER=clonix-pairing-hmac-secret-pepper-v1
# Server-side pepper for billing hash calculations
BILLING_PEPPER=clonix-billing-hmac-secret-pepper-v1

# ==============================================================================
# 4. SHOPIFY APP CREDENTIALS & BILLING
# ==============================================================================
SHOPIFY_API_KEY=your_shopify_app_api_key
SHOPIFY_API_SECRET=your_shopify_app_api_secret
SHOPIFY_API_VERSION=2026-10
# Set to "true" to test Shopify AppPurchaseOneTime on development stores without real charges
BILLING_TEST=true

# ==============================================================================
# 5. CLOUDFLARE R2 OBJECT VAULT (Streaming JSONL & Backups)
# ==============================================================================
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=clonix-vault

# ==============================================================================
# 6. LOCAL CLI & MIGRATION RUNNER FALLBACK
# ==============================================================================
SOURCE_SHOP=ph0igg-jv.myshopify.com
SOURCE_CLIENT_ID=
SOURCE_CLIENT_SECRET=
# SOURCE_ADMIN_TOKEN=shpat_...

DEST_SHOP=your-destination-store.myshopify.com
DEST_CLIENT_ID=
DEST_CLIENT_SECRET=
# DEST_ADMIN_TOKEN=shpat_...

# Dry-run mode for safety (true blocks all live store mutations)
DRY_RUN=false
